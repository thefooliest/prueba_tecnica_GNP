{
  "name": "gnp-tasks-api",
  "version": "1.0.0",
  "description": "API REST de gestión de tareas con Hono, Bun y SQLite + documentación OpenAPI",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "openapi": "bun run scripts/openapi.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  }
}