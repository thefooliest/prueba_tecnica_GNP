# Puerto del servidor HTTP
PORT=3000
HOST=0.0.0.0

# Ruta del fichero SQLite (el directorio se crea automáticamente)
DATABASE_PATH=data/tasks.sqlite

# Token Bearer para proteger /tasks.
# Si se deja vacío la autenticación queda DESHABILITADA (sólo para desarrollo).
API_TOKEN=cambia-este-token

# Montar la interfaz Swagger UI en /docs
DOCS_ENABLED=true

# Versión publicada en la documentación OpenAPI
API_VERSION=1.0.0